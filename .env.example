# 复制成 .env（.env 不进仓库）。本地开发连模拟器；上线时这些变量在 Cloud Run 上设置（密钥放 Secret Manager）。

# ── 本地模拟器（cd web && npm run emulators）──
GOOGLE_CLOUD_PROJECT=demo-kebunsah
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── 证件照存放 ──
# local：文件放在本地目录，API 自己收上传（只给开发用）；gcs：线上，签名网址直传 bucket
BLOBS_MODE=local
BLOBS_DIR=.local-blobs
PUBLIC_BASE_URL=http://127.0.0.1:8000
# BLOBS_MODE=gcs 时必填
# STORAGE_BUCKET=

# ── Gemini（去 aistudio.google.com 拿 key，不用绑卡）──
GEMINI_API_KEY=
# 模型 id 放配置；用 scripts/gemini_smoke.py --list-models 看这个 key 能用哪些，再核对
# 可以写逗号分隔的一串备选：第一个额度用完（免费档每个模型每天约 20 次）或不可用时自动换下一个
GEMINI_EXTRACT_MODEL=gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3.1-flash-lite
GEMINI_EXPLAIN_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=40

# ── 森林初筛 ──
# demo（默认）：固定的演示数据，界面会如实写「演示数据」；earthengine：真的查 Google Earth Engine（要项目已注册 Earth Engine）
FOREST_BACKEND=demo

# ── 其他 ──
# 浏览器来源（逗号分隔）。线上填 Firebase Hosting 的网址
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# 演示时钉死评估日期（YYYY-MM-DD）；不设就用当天（马来西亚时间）
# ASSESS_AS_OF=2026-10-09
# 只想看接口、不起 Firestore 模拟器时设 memory（重启就清空）
# STORE_BACKEND=memory
